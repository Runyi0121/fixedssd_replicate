[Object43]
_Version=131072
_ExtentX=2646
_ExtentY=1323
_StockProps=0
VersionMajor=1
VersionMinor=2
VersionInternal=1
VersionBuild=67
_VersionPersist=1
Code="Dim SubjectNr as Integer\n\nSubjectNr =  c.GetAttrib (\"Subject\")\n\nIf SubjectNr mod 6 = 1 then\n\tc.SetAttrib \"TriangleResponse\", \"Z\"\n\tc.SetAttrib \"CircleResponse\", \"Z\"\n\tc.SetAttrib \"SquareResponse\", \"M\"\n\tc.SetAttrib \"RhombusResponse\", \"M\"\nElseIf SubjectNr mod 6 = 2 then\n\tc.SetAttrib \"TriangleResponse\", \"Z\"\n\tc.SetAttrib \"CircleResponse\", \"M\"\n\tc.SetAttrib \"SquareResponse\", \"Z\"\n\tc.SetAttrib \"RhombusResponse\", \"M\"\nElseIf SubjectNr mod 6 = 3 then\n\tc.SetAttrib \"TriangleResponse\", \"Z\"\n\tc.SetAttrib \"CircleResponse\", \"M\"\n\tc.SetAttrib \"SquareResponse\", \"M\"\n\tc.SetAttrib \"RhombusResponse\", \"Z\"\nElseIf SubjectNr mod 6 = 4 then\n\tc.SetAttrib \"TriangleResponse\", \"M\"\n\tc.SetAttrib \"CircleResponse\", \"Z\"\n\tc.SetAttrib \"SquareResponse\", \"Z\"\n\tc.SetAttrib \"RhombusResponse\", \"M\"\nElseIf SubjectNr mod 6 = 5 then\n\tc.SetAttrib \"TriangleResponse\",\"M\"\n\tc.SetAttrib \"CircleResponse\", \"Z\"\n\tc.SetAttrib \"SquareResponse\", \"M\"\n\tc.SetAttrib \"RhombusResponse\", \"Z\"\nElseIf SubjectNr mod 6 = 0 then\n\tc.SetAttrib \"TriangleResponse\", \"M\"\n\tc.SetAttrib \"CircleResponse\", \"M\"\n\tc.SetAttrib \"SquareResponse\", \"Z\"\n\tc.SetAttrib \"RhombusResponse\", \"Z\"\nEnd if \n\n\nc.SetAttrib \"StopSignal\", \"500Hz.wav\""
Name="ResponseSetup"
TypeName="InLine"
Tag=""
Notes=""

